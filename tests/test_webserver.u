	tests = tests + [test_ws_frame_encode()]
	tests = tests + [test_error_fallback()]
	tests = tests + [test_error_typed_dispatch()]
	// New tests (22 more)
	tests = tests + [test_path_traversal_blocked()]
	tests = tests + [test_hidden_files_blocked()]
	tests = tests + [test_parse_empty_request()]
	tests = tests + [test_parse_no_headers()]
	tests = tests + [test_parse_url_encoded_path()]
	tests = tests + [test_parse_multiple_query_params()]
