	tests = tests + [test_session_delete()]
	tests = tests + [test_session_clear()]
	tests = tests + [test_session_cookie_header()]

	passed = tests.filter(tt => tt.passed).len
	total = tests.len
	log(passed.__string__() + "/" + total.__string__() + " tests passed")
	tests.filter(tt => tt.passed == false).on(tt => (
		log("  FAIL  " + tt.name + "  " + tt.message)
		none
	))
	none
