// dashboard — server stats and live monitoring
//
// Tracks requests, status codes, response times, throughput.
// Serves /Q/dashboard (HTML) and /Q/health (JSON).
// Pushes live updates via WebSocket on the 'dashboard' channel.

d DashboardStats
	start_time: I +M = 0
	requests: I +M = 0
	status_2xx: I +M = 0
	status_3xx: I +M = 0
	status_4xx: I +M = 0
	status_5xx: I +M = 0
	bytes_out: I +M = 0
	total_ms: I +M = 0
	slowest_ms: I +M = 0
	slowest_uri: S +M = ""

d RequestLog
	method: S +M
	uri: S +M
	status: I +M
	ms: I +M
	timestamp: I +M

d Dashboard +G
	stats: DashboardStats +G = DashboardStats({})
	recent: [RequestLog] +G = []
	top_paths: {S: I} +G = {}
	max_recent: I +G = 100

	z f init() -> none
		t.stats.start_time = time.now()

	z f record(method: S, uri: S, status: I, ms: I, bytes: I) -> none
		t.stats.requests = t.stats.requests + 1
		t.stats.total_ms = t.stats.total_ms + ms
		t.stats.bytes_out = t.stats.bytes_out + bytes

		status < 300 ? t.stats.status_2xx = t.stats.status_2xx + 1
		status >= 300 ? status < 400 ? t.stats.status_3xx = t.stats.status_3xx + 1
		status >= 400 ? status < 500 ? t.stats.status_4xx = t.stats.status_4xx + 1
		status >= 500 ? t.stats.status_5xx = t.stats.status_5xx + 1

		ms > t.stats.slowest_ms ? t.stats.slowest_ms = ms
		ms > t.stats.slowest_ms ? t.stats.slowest_uri = uri

		// Track top paths
		count = t.top_paths.get(uri) ?? 0
		t.top_paths.set(uri, count + 1)

		// Recent requests (ring buffer)
		t.recent = t.recent.len >= t.max_recent
			? t.recent.slice(1, t.recent.len) + [RequestLog({
				method: method, uri: uri, status: status,
				ms: ms, timestamp: time.now()
			})]
			! t.recent + [RequestLog({
				method: method, uri: uri, status: status,
				ms: ms, timestamp: time.now()
			})]

	z f health_json() -> S
		uptime = time.now() - t.stats.start_time
		avg_ms = t.stats.requests > 0 ? t.stats.total_ms / t.stats.requests ! 0
		rps = uptime > 0 ? t.stats.requests / uptime ! 0
		r => json.encode({
			"status": "ok",
			"uptime_seconds": uptime,
			"requests": t.stats.requests,
			"rps": rps,
			"avg_ms": avg_ms,
			"status_2xx": t.stats.status_2xx,
			"status_4xx": t.stats.status_4xx,
			"status_5xx": t.stats.status_5xx,
			"bytes_out": t.stats.bytes_out,
			"slowest_ms": t.stats.slowest_ms,
			"slowest_uri": t.stats.slowest_uri
		})

	z f dashboard_html() -> S
		uptime = time.now() - t.stats.start_time
		avg_ms = t.stats.requests > 0 ? t.stats.total_ms / t.stats.requests ! 0
		r => html`<!DOCTYPE html>
<html><head>
<title>U WebServer — Dashboard</title>
<meta charset="utf-8">
<style>
body{font-family:system-ui;background:#12141c;color:#dce1ec;margin:0;padding:24px}
h1{color:#4ec9b0;font-size:24px}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:16px 0}
.card{background:#1e2130;padding:16px;border-radius:8px;text-align:center}
.card .n{font-size:28px;font-weight:700;color:#569cd6}
.card .l{color:#889;font-size:13px}
table{width:100%;border-collapse:collapse;margin:16px 0}
th,td{text-align:left;padding:8px;border-bottom:1px solid #2a2d3a}
th{color:#889;font-size:13px}
.s2{color:#4ec9b0}.s3{color:#569cd6}.s4{color:#fa3}.s5{color:#f44}
</style>
</head><body>
<h1>U WebServer</h1>
<div class="grid">
  <div class="card"><div class="n">{{t.stats.requests}}</div><div class="l">Requests</div></div>
  <div class="card"><div class="n">{{avg_ms}}ms</div><div class="l">Avg Response</div></div>
  <div class="card"><div class="n">{{uptime}}s</div><div class="l">Uptime</div></div>
  <div class="card"><div class="n">{{t.stats.bytes_out}}</div><div class="l">Bytes Out</div></div>
</div>
<div class="grid">
  <div class="card"><div class="n s2">{{t.stats.status_2xx}}</div><div class="l">2xx</div></div>
  <div class="card"><div class="n s3">{{t.stats.status_3xx}}</div><div class="l">3xx</div></div>
  <div class="card"><div class="n s4">{{t.stats.status_4xx}}</div><div class="l">4xx</div></div>
  <div class="card"><div class="n s5">{{t.stats.status_5xx}}</div><div class="l">5xx</div></div>
</div>
<h2>Recent Requests</h2>
<table>
<tr><th>Method</th><th>URI</th><th>Status</th><th>Time</th></tr>
</table>
</body></html>`
