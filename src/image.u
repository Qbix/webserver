// image — on-the-fly image resize and format conversion
//
// Intercepts image requests with ?ww = or ?hh = query params.
// Converts between formats (request .webp, source is .png).
// Caches results to disk.
//
// Uses stb_image.h and stb_image_write.h via C FFI — single-header
// libraries, no external dependencies.

d ImageConfig
	cache_dir: S +M = ".cache/images"
	max_cache_bytes: I +M = 268435456   // 256MB
	source_formats: [S] -M = ["png", "jpg", "jpeg", "gif", "webp", "bmp"]
	output_formats: [S] -M = ["webp", "jpg", "png", "gif", "avif"]
	max_width: I +M = 4096
	max_height: I +M = 4096
	quality: I +M = 85

d ImageRequest
	source_path: S +M         // path to source image on disk
	width: I +M = 0           // requested width (0 = auto)
	height: I +M = 0          // requested height (0 = auto)
	format: S +M = ""         // output format (empty = same as source)
	quality: I +M = 85

d ImageResult
	data: [B] -M
	content_type: S +M
	cache_path: S +M = ""

/// Parse image request params from query string
f parse_image_request(fs_path: S, query: S) -> ImageRequest +N
	params = query.split("&").map(p => p.split("="))
	width = 0
	height = 0
	params.on(pair => (
		pair.len >= 2 ? (
			pair[0] == "w" ? width = pair[1].__int__()
			pair[0] == "h" ? height = pair[1].__int__()
		)
	))
	width == 0 ? height == 0 ? r => none
	r => ImageRequest({
		source_path: fs_path,
		width: width,
		height: height,
		quality: 85
	})

/// Generate cache key for a resize request
f cache_key(req: ImageRequest) -> S
	base = filesystem.basename(req.source_path)
	name = base.split(".")[0]
	ext = req.format.len > 0 ? req.format ! filesystem.extension(req.source_path)
	r => `{{name}}/{{req.width}}x{{req.height}}.{{ext}}`

/// Resize an image (calls C FFI)
f+E resize_image(req: ImageRequest, config: ImageConfig) -> ImageResult ! ImageError
	// Check cache first
	key = cache_key(req)
	cached_path = filesystem.join([config.cache_dir, key])
	cached = filesystem.is_file(cached_path)
	cached ? r => ImageResult({
		data: filesystem.read_bytes(cached_path),
		content_type: mime.lookup(filesystem.extension(cached_path)),
		cache_path: cached_path
	})

	// Clamp dimensions
	ww = req.width > 0 ? req.width.min(config.max_width) ! 0
	hh = req.height > 0 ? req.height.min(config.max_height) ! 0

	// Load source image via stb_image (C FFI)
	source = image_load(req.source_path) ! x ImageError({ message: "failed to load" })

	// Compute output dimensions maintaining aspect ratio
	ww == 0 ? ww = source.width * h / source.height
	hh == 0 ? hh = source.height * w / source.width

	// Resize via stb_image_resize
	resized = image_resize(source, ww, hh) ! x ImageError({ message: "resize failed" })

	// Encode to output format
	ext = req.format.len > 0 ? req.format ! filesystem.extension(req.source_path)
	encoded = image_encode(resized, ext, req.quality) ! x ImageError({ message: "encode failed" })

	// Cache to disk
	filesystem.mkdir(filesystem.dirname(cached_path))
	filesystem.write_bytes(cached_path, encoded)

	r => ImageResult({
		data: encoded,
		content_type: mime.lookup(ext),
		cache_path: cached_path
	})

/// Try format conversion: request photo.webp when only photo.png exists
f+E try_format_convert(fs_path: S, request_ext: S, config: ImageConfig) -> ImageResult +N ! ImageError
	base = fs_path.slice(0, fs_path.len - request_ext.len - 1)
	// Try each source format
	found = none
	config.source_formats.on(src_ext => (
		candidate = base + "." + src_ext
		filesystem.is_file(candidate) ? found = candidate
	))
	found == none ? r => none

	req = ImageRequest({
		source_path: found,
		format: request_ext,
		quality: config.quality
	})
	r => resize_image(req, config)

// ── C FFI declarations (stb_image) ──────────────────────────────────

d ImageData
	pixels: [B] -M
	width: I +M
	height: I +M
	channels: I +M = 4

// These would be implemented via C FFI to stb_image.h
f+E image_load(path: S) -> ImageData ! ImageError
	...

f image_resize(src: ImageData, w: I, h: I) -> ImageData ! ImageError
	...

f image_encode(src: ImageData, format: S, quality: I) -> [B] ! ImageError
	...

x ImageError
	message: S +M
