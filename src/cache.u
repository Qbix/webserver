// cache — LRU file cache with mtime validation

d CacheEntry
	data: [B] -M
	mtime: I +M
	last_access: I +M = 0
	size: I +M

d FileCache
	entries: {S: CacheEntry} +M = {}
	total_bytes: I +M = 0
	max_bytes: I +M
	max_file_bytes: I +M
	hit_count: I +M = 0
	miss_count: I +M = 0

	f+G create(max_bytes: I, max_file: I) -> FileCache +R
		r => FileCache({ max_bytes: max_bytes, max_file_bytes: max_file })

	f get(path: S, current_mtime: I) -> [B] +N
		t.entries.has(path) == false ? r => none
		entry = t.entries[path]
		entry.mtime != current_mtime ? r => none
		entry.last_access = time.now()
		t.hit_count = t.hit_count + 1
		r => entry.data

	f put(path: S, data: [B], mtime: I) -> none
		data.len > t.max_file_bytes ? r => none
		t.total_bytes + data.len > t.max_bytes ? t.evict(data.len)
		t.entries.has(path) ? t.remove_entry(path)
		t.entries = t.entries.set(path, CacheEntry({
			data: data, mtime: mtime,
			last_access: time.now(), size: data.len
		}))
		t.total_bytes = t.total_bytes + data.len
		t.miss_count = t.miss_count + 1
		none

	f remove_entry(path: S) -> none
		t.entries.has(path) == false ? r => none
		old = t.entries[path]
		t.total_bytes = t.total_bytes - old.size
		t.entries = t.entries.delete(path)
		none

	f evict(needed_bytes: I) -> none
		t.total_bytes + needed_bytes <= t.max_bytes ? r => none
		oldest_path: S +M +N = none
		oldest_time: I +M = 2000000000
		t.entries.on((path, entry) => entry.last_access < oldest_time ? (
			oldest_time = entry.last_access
			oldest_path = key
			none
		) ! none)
		oldest_path != none ? t.remove_entry(oldest_path)
		t.evict(needed_bytes)
		none

	f+E check_mtime() -> none
		stale: [S] +M = []
		t.entries.on((path, entry) => (
			current = filesystem.stat(path) x none
			current == none ? stale = stale + [path]
			! current.mtime != entry.mtime ? stale = stale + [path]
			none
		))
		stale.on(path => t.remove_entry(path))
		none

	f stats() -> {S: I}
		r => {
			"entries": t.entries.len,
			"bytes": t.total_bytes,
			"hits": t.hit_count,
			"misses": t.miss_count
		}
