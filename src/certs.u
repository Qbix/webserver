// certs — TLS certificate management with auto-renewal
//
// Two modes:
//   1. certbot: shells out to certbot for Let's Encrypt certs
//   2. manual: reads cert/key from configured paths
//
// Checks expiry on a timer and renews automatically.

d CertConfig
	mode: S +M = "manual"          // "certbot" | "manual"
	cert_path: S +M = ""           // path to fullchain.pem
	key_path: S +M = ""            // path to privkey.pem
	domain: S +M = ""              // domain for certbot
	email: S +M = ""               // email for certbot
	renew_days_before: I +M = 30   // renew when expiry < N days
	check_interval_s: I +M = 86400 // check every 24h

d CertState +G
	cert_path: S +G = ""
	key_path: S +G = ""
	expiry: I +G = 0
	valid: L +G = false

/// Initialize certs from config
f+E init_certs(config: CertConfig) -> CertState ! CertError
	config.mode == "manual" & config.cert_path.len == 0 ? x CertError({ message: "cert_path required" })
	config.mode == "manual" & config.key_path.len == 0 ? x CertError({ message: "key_path required" })
	config.mode == "manual" ? r => CertState({
		cert_path: config.cert_path,
		key_path: config.key_path,
		expiry: cert_expiry(config.cert_path),
		valid: cert_expiry(config.cert_path) > time.now()
	})

	cert_dir = "/etc/letsencrypt/live/" + config.domain
	cert_file = cert_dir + "/fullchain.pem"
	key_file = cert_dir + "/privkey.pem"
	config.mode == "certbot" & config.domain.len == 0 ? x CertError({ message: "domain required for certbot" })
	config.mode == "certbot" ? r => CertState({
		cert_path: cert_file,
		key_path: key_file,
		expiry: cert_expiry(cert_file),
		valid: cert_expiry(cert_file) > time.now()
	})

	x CertError({ message: "unknown cert mode: " + config.mode })
	r => CertState({})

/// Run certbot to obtain a certificate
f+E obtain_cert(config: CertConfig) -> none ! CertError
	cmd: S +M = "certbot certonly --standalone"
		+ " -d " + config.domain
		+ " --non-interactive --agree-tos"
	config.email.len > 0 ? cmd = cmd + " --email " + config.email
	! cmd = cmd + " --register-unsafely-without-email"

	result = process.exec(cmd)
	result.exit_code != 0 ? x CertError({
		message: "certbot failed: " + result.stderr
	})

/// Run certbot renew
f+E renew_cert(config: CertConfig) -> none ! CertError
	result = process.exec("certbot renew --non-interactive")
	result.exit_code != 0 ? x CertError({
		message: "certbot renew failed: " + result.stderr
	})

/// Check certificate expiry (days remaining)
f+E cert_expiry(cert_path: S) -> I ! CertError
	result = process.exec("openssl x509 -enddate -noout -in " + cert_path)
	result.exit_code != 0 ? x CertError({ message: "cannot read cert" })
	// Parse "notAfter=Aug  2 12:00:00 2026 GMT"
	date_str = result.stdout.split("=")[1].trim()
	r => time.parse(date_str, "MMM dd HH:mm:ss yyyy z")

/// Check if renewal is needed and renew
f+E check_renewal(config: CertConfig, state: CertState +M) -> L ! CertError
	days_left = (state.expiry - time.now()) / 86400
	days_left > config.renew_days_before ? r => false

	config.mode == "certbot" ? r => true  // renewal triggered

	r => false

x CertError
	message: S +M
